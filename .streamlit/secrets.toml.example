# Google Gemini API Key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY = "your-gemini-api-key-here"

# Gmail SMTP Configuration for sending email digests
# Setup: Turn on 2-Step Verification on your Gmail account,
# then create an App Password at: https://myaccount.google.com/apppasswords
# Use that 16-character App Password here (never use your actual account password).
GMAIL_ADDRESS = "your-email@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
